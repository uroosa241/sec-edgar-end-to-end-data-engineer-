sec_edgar:
  target: dev
  outputs:
    dev:
      type: databricks
      method: http
      host: "{{ env_var('DATABRICKS_HOST') }}"
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH') }}"
      token: "{{ env_var('DATABRICKS_TOKEN') }}"
      catalog: "{{ env_var('DBT_CATALOG', 'sec_edgar') }}"
      schema: "{{ env_var('DBT_GOLD_SCHEMA', 'gold') }}"
      threads: 4
    prod:
      type: databricks
      method: http
      host: "{{ env_var('DATABRICKS_HOST') }}"
      http_path: "{{ env_var('DATABRICKS_HTTP_PATH') }}"
      token: "{{ env_var('DATABRICKS_TOKEN') }}"
      catalog: "{{ env_var('DBT_CATALOG', 'sec_edgar') }}"
      schema: "{{ env_var('DBT_GOLD_SCHEMA', 'gold') }}"
      threads: 8
